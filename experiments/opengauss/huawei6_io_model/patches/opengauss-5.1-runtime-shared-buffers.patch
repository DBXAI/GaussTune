+static bool TryRetireBufferForResize(BufferDesc *buf)
+{
+    BufferTag old_tag;
+    uint32 old_hash;
+    uint32 buf_state = LockBufHdr(buf);
+
+    if (!(buf_state & BM_TAG_VALID)) {
+        bool reusable = BUF_STATE_GET_REFCOUNT(buf_state) == 0 &&
+            !(buf_state & (BM_DIRTY | BM_IO_IN_PROGRESS));
+        UnlockBufHdr(buf, buf_state);
+        if (reusable) {
+            g_instance.ckpt_cxt_ctl->candidate_free_map[buf->buf_id] = false;
+        }
+        return reusable;
+    }
+
+    old_tag = buf->tag;
+    UnlockBufHdr(buf, buf_state);
+    old_hash = BufTableHashCode(&old_tag);
+    LWLock *partition_lock = BufMappingPartitionLock(old_hash);
+    (void)LWLockAcquire(partition_lock, LW_EXCLUSIVE);
+    buf_state = LockBufHdr(buf);
+
+    if (!BUFFERTAGS_EQUAL(buf->tag, old_tag) || BUF_STATE_GET_REFCOUNT(buf_state) != 0 ||
+        (buf_state & (BM_DIRTY | BM_IO_IN_PROGRESS)) || ENABLE_DMS) {
+        UnlockBufHdr(buf, buf_state);
+        LWLockRelease(partition_lock);
+        return false;
+    }
+
+    uint32 old_flags = buf_state & BUF_FLAG_MASK;
+    CLEAR_BUFFERTAG(buf->tag);
+    buf_state &= ~(BUF_FLAG_MASK | BUF_USAGECOUNT_MASK);
+    UnlockBufHdr(buf, buf_state);
+    if (old_flags & BM_TAG_VALID) {
+        BufTableDelete(&old_tag, old_hash);
+    }
+    g_instance.ckpt_cxt_ctl->candidate_free_map[buf->buf_id] = false;
+    LWLockRelease(partition_lock);
+    return true;
+}
+
+bool RetireSharedBufferTail(WritebackContext* wb_context)
+{
+    int active = StrategyGetActiveBufferCount();
+    int resize_target = StrategyGetBufferResizeTarget();
+
+    if (resize_target >= active) {
+        return true;
+    }
+    int target = StrategyStartBufferResizeStep();
+    if (g_instance.attr.attr_storage.enable_huge_pages || ENABLE_DMS) {
+        ereport(WARNING,
+            (errmsg("shared buffer resize requires huge pages and DMS to be disabled")));
+        return false;
+    }
+
+    bool all_retired = true;
+    for (int buf_id = active - 1; buf_id >= target; --buf_id) {
+        BufferDesc *buf = GetBufferDescriptor(buf_id);
+        uint32 state = pg_atomic_read_u32(&buf->state);
+        if (state & BM_DIRTY) {
+            ResourceOwnerEnlargeBuffers(t_thrd.utils_cxt.CurrentResourceOwner);
+            (void)SyncOneBuffer(buf_id, false, wb_context);
+        }
+        if (!TryRetireBufferForResize(buf)) {
+            all_retired = false;
+        }
+    }
+    IssuePendingWritebacks(wb_context);
+
+    if (!all_retired || target != StrategyGetBufferAllocationLimit()) {
+        return false;
+    }
+
+    long page_size = sysconf(_SC_PAGESIZE);
+    uintptr_t raw_begin = (uintptr_t)t_thrd.storage_cxt.BufferBlocks + (uintptr_t)target * BLCKSZ;
+    uintptr_t raw_end = (uintptr_t)t_thrd.storage_cxt.BufferBlocks + (uintptr_t)active * BLCKSZ;
+    uintptr_t begin = TYPEALIGN((uintptr_t)page_size, raw_begin);
+    uintptr_t end = TYPEALIGN_DOWN((uintptr_t)page_size, raw_end);
+    if (end > begin && madvise((void*)begin, end - begin, MADV_REMOVE) != 0) {
+        ereport(WARNING,
+            (errmsg("could not release retired shared buffer pages: %m")));
+        return false;
+    }
+
+    StrategyCommitBufferResize(target);
+    ereport(LOG,
+        (errmsg("shared buffer resize committed: active buffers %d, released %lu bytes",
+            target, (unsigned long)(end - begin))));
+    return target == StrategyGetBufferResizeTarget();
+}
